# Private draft. Leave unset, or set to anything other than "true",
# and the site sends noindex, nofollow. robots.txt disallows crawling.
# NEXT_PUBLIC_ values are inlined at build time, so change this and rebuild.
# Set to "true" only when the public site should be indexed at launch.
NEXT_PUBLIC_SITE_INDEXABLE=false

# Optional. Analytics stay off when this is empty.
# TODO: connect the provider in components/analytics.tsx before relying on it.
# NEXT_PUBLIC_ANALYTICS_ID=
